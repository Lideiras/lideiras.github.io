# Copia este archivo a `.env` y rellena el valor.
#
# Endpoint que recibe los envíos del formulario de contacto (sección
# "Entrevístame"). Debe aceptar POST con JSON y devolver 2xx.
#
# Sin esta variable el formulario muestra el aviso de que el envío no está
# configurado, pero el resto del juego funciona con normalidad.
VITE_FORM_ENDPOINT=
